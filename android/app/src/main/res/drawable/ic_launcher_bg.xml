<?xml version="1.0" encoding="utf-8"?>
<!-- The ground the two pages sit on, and the same gradient public/icon.svg
     uses. A flat colour would do, but the launcher shows this icon beside the
     app's own splash and header, and a gradient that stops at the launcher is
     the kind of seam people notice without being able to say why. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <gradient
        android:startColor="#2F74FF"
        android:endColor="#0A4FDC"
        android:angle="270" />
</shape>
